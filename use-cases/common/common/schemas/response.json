{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CorporateDecisionResponseSchema",
  "type": "object",
  "required": ["allowed", "decision_code", "reasons", "timestamp_ns", "metadata"],
  "properties": {
    "allowed": {
      "type": "boolean"
    },
    "decision_code": {
      "type": "string",
      "minLength": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timestamp_ns": {
      "type": "integer"
    },
    "metadata": {
      "type": "object",
      "required": ["policy_id", "version"],
      "properties": {
        "policy_id": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
