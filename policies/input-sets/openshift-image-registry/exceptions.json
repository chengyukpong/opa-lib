{
  "id": "exceptions",
  "name": "例外與過期",
  "description": "有票的例外應通過；缺票或過期應拒絕。",
  "cases": {
    "legacy-ok": {
      "name": "Legacy 例外（有票）",
      "description": "quay.io/acme-legacy + CHG-1024",
      "input": { "image": "quay.io/acme-legacy/old-app:1.0", "namespace": "legacy" },
      "expected": true
    },
    "nginx-no-ticket": {
      "name": "缺票例外",
      "description": "data.exceptions 中 ticket 為 null",
      "input": { "image": "docker.io/library/nginx:1.25", "namespace": "prod" },
      "expected": false
    },
    "random-external": {
      "name": "隨意外部鏡像",
      "description": "不在任何清單",
      "input": { "image": "ghcr.io/someone/random:latest", "namespace": "prod" },
      "expected": false
    }
  }
}
