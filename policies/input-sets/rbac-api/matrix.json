{
  "id": "matrix",
  "name": "角色矩陣",
  "description": "admin / editor / viewer 在同租戶下的讀寫。",
  "cases": {
    "admin-delete": {
      "name": "Admin 刪除",
      "input": {
        "subject": { "user_id": "u-admin", "roles": ["admin"], "tenant": "acme" },
        "action": "delete",
        "resource": { "tenant": "acme", "owner_id": "u-other", "type": "invoice" }
      },
      "expected": true
    },
    "viewer-update": {
      "name": "Viewer 更新他人資源",
      "input": {
        "subject": { "user_id": "u-view", "roles": ["viewer"], "tenant": "acme" },
        "action": "update",
        "resource": { "tenant": "acme", "owner_id": "u-other", "type": "invoice" }
      },
      "expected": false
    },
    "editor-update": {
      "name": "Editor 更新",
      "input": {
        "subject": { "user_id": "u-ed", "roles": ["editor"], "tenant": "acme" },
        "action": "update",
        "resource": { "tenant": "acme", "owner_id": "u-other", "type": "doc" }
      },
      "expected": true
    }
  }
}
